rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 인증 문서 (임시, 7일 후 삭제)
    match /verifications/{userId}/{allPaths=**} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 부동산 이미지
    match /listings/{listingId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 맛집·생활정보 이미지
    match /places/{placeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 게시글 첨부 이미지
    match /posts/{postId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null
                    && getUserVerified(request.auth.uid) == true;
      allow delete: if request.auth.uid == getPostAuthor(postId);
    }

    // Helper functions
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == 'admin';
    }

    function getUserVerified(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.verified;
    }

    function getPostAuthor(postId) {
      return firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorId;
    }

    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

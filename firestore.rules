rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 함수 ───────────────────────────────────────────
    function isAdmin(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── 학교 ─────────────────────────────────────────────────
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 사용자 ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && !('verified' in request.resource.data.diff(resource.data).affectedKeys())
        && !('role' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // ── 게시글 + 댓글 ────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isVerified();
      allow update: if isOwner(resource.data.authorId)
        || (isAuthenticated() && isAdmin(request.auth.uid));
      allow delete: if isOwner(resource.data.authorId)
        || (isAuthenticated() && isAdmin(request.auth.uid));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isVerified();
        allow update, delete: if isOwner(resource.data.authorId)
          || (isAuthenticated() && isAdmin(request.auth.uid));
      }
    }

    // ── 반응 (좋아요·신고) ───────────────────────────────────
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId);
    }

    // ── 인증 기록 ─────────────────────────────────────────────
    match /verifications/{verifId} {
      allow read: if isAuthenticated()
        && (isOwner(resource.data.userId) || isAdmin(request.auth.uid));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // ── 매거진 이슈 ──────────────────────────────────────────
    match /magazine_issues/{issueId} {
      // 발행된 이슈만 공개
      allow read: if resource.data.status == 'published'
        || (isAuthenticated() && isAdmin(request.auth.uid));
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 매거진 아이템 ─────────────────────────────────────────
    match /magazine_items/{itemId} {
      // ready 또는 used 상태만 공개
      allow read: if resource.data.status in ['ready', 'used']
        || (isAuthenticated() && isAdmin(request.auth.uid));
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 구독자 ───────────────────────────────────────────────
    match /subscribers/{subId} {
      // 본인 확인용: 어드민만 목록 조회
      allow read: if isAuthenticated() && isAdmin(request.auth.uid);
      // 구독 폼은 누구나 생성 가능
      allow create: if true;
      // 상태 변경(confirm/unsubscribe)은 토큰 기반으로 서버에서 처리
      allow update: if isAuthenticated() && isAdmin(request.auth.uid);
      allow delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 아티클 (SEO) ──────────────────────────────────────────
    match /articles/{articleId} {
      // 발행 + noindex=false 인 글만 공개
      allow read: if (resource.data.status == 'published' && resource.data.noindex == false)
        || (isAuthenticated() && isAdmin(request.auth.uid));
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── SEO 아이디어·RSS·콘텐츠 필터 ─────────────────────────
    match /seo_ideas/{ideaId} {
      allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /rss_items/{rssId} {
      allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /content_filters/{filterId} {
      allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /prompts/{promptId} {
      allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 공지 ─────────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 부동산 매물 ──────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if resource.data.isActive == true
        || (isAuthenticated() && isAdmin(request.auth.uid));
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 뉴스 아이템 ──────────────────────────────────────────
    match /news_items/{newsId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // ── 장소 ─────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

  }
}
